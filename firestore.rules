rules_version = '2';
// Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Pupils: student01@ipc.local ... Teacher: teacher@ipc.local
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null && request.auth.token.email != null; }
    function me()        { return request.auth.token.email.split('@')[0]; }
    function onDomain()  { return request.auth.token.email.matches('.*@ipc[.]local$'); }
    function isTeacher() { return signedIn() && request.auth.token.email == 'teacher@ipc.local'; }
    function isPupil()   { return signedIn() && onDomain() && me().matches('student[0-9]{2,3}'); }

    // Pupil work: each pupil reads/writes only their own; the teacher can read everyone's.
    match /work/{user}/items/{item} {
      allow read: if isTeacher() || (isPupil() && me() == user);
      allow write: if isPupil() && me() == user
                   && request.resource.data.keys().hasOnly(['lessonId', 'activityId', 'data', 'updatedAt'])
                   && request.resource.data.lessonId is string
                   && request.resource.data.activityId is string;
    }

    // Which lessons are open: everyone signed in can read, only the teacher can change.
    match /config/{doc} {
      allow read: if isPupil() || isTeacher();
      allow write: if isTeacher();
    }

    // Tower Builder leaderboard: one best score per pupil, 0-200 m.
    match /scores/{user} {
      allow read: if isPupil() || isTeacher();
      allow create, update: if isPupil() && me() == user
                            && request.resource.data.keys().hasOnly(['username', 'best', 'updatedAt'])
                            && request.resource.data.username == user
                            && request.resource.data.best is number
                            && request.resource.data.best >= 0
                            && request.resource.data.best <= 200;
      allow delete: if isTeacher();
    }
  }
}
